
# Mix of paired molecules (fire, water) and single atoms (earth, air, salt, metal).
# Long idle window so the static scene is visible before the arm disturbs the metal atom.

# Two adjacent fire entrances that bond their atoms into a molecule.
comp 1 1 entrance atom_type=fire # id 0
comp 1 2 entrance atom_type=fire # id 1

# Two adjacent water entrances that bond their atoms into a molecule.
comp 3 1 entrance atom_type=water # id 2
comp 3 2 entrance atom_type=water # id 3

# Four single-atom entrances of the remaining types.
comp 5 1 entrance atom_type=earth # id 4
comp 7 1 entrance atom_type=air   # id 5
comp 5 3 entrance atom_type=salt  # id 6
comp 7 3 entrance atom_type=metal # id 7

# Required exits, placed out of the way so nothing is consumed automatically.
comp 8 8 exit atom_type=fire  # id 8
comp 8 6 exit atom_type=water # id 9
comp 8 4 exit atom_type=earth # id 10
comp 6 8 exit atom_type=air   # id 11

# Link the same-type entrance pairs so they spawn bonded molecules.
connection 0 1
connection 2 3

# Arm at (8,3) reaches the metal entrance at (7,3) when rotated to 5.
comp 8 3 arm # id 12

# Steps 0-14: all entrances spawn; the fire/water pairs bond, and the rest sit as single atoms.
# Steps 15-18: the arm grabs the metal atom and moves it to (7,4), leaving the other colors untouched.
action 12 15 rotate_cclw
action 12 16 grab
action 12 17 rotate_clw
action 12 18 release
