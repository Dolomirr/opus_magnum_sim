
comp 2 4 entrance atom_type=basic # id 0
comp 2 5 entrance atom_type=basic # id 1

# link the two entrances
connection 0 1

comp 4 3 exit atom_type=basic     # id 2
comp 5 2 exit atom_type=basic     # id 3

# link the two exits
connection 2 3

comp 3 3 arm                      # id 4

                                  # pair spawn
action 4 4 grab                   # grab bonded pair
                                  # arm holds the pair
action 4 8 rotate_clw             # swing hand clock-wise
                                  # arm holds rotated pair
action 4 12 release               # drop the pair
                                  # molecule at new location
action 4 17 grab                  # grab again
                                  # arm holds it again
action 4 21 rotate_clw            # swing hand clw again (now molecules above exits)
                                  # arm still holds the pair over the exits
action 4 25 release               # drop onto the exits
