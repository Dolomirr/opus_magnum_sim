
# Shows two manipulator rotation actions
# full rotation with arm moving around base
# in-place rotation with arm staying as is,
# and only held molecule rotates around the hand
#
# DEPRECATED - uses low-level `comp` primitives.

# connected entrances
comp 4 5 entrance atom_type=basic # id 0
comp 4 6 entrance atom_type=basic # id 1
connection 0 1

# arm at (5,5)
comp 5 5 arm                      # id 2

# exit, unreachable
comp 8 8 exit atom_type=basic     # id 3

# grab pair
action 2 1 grab

# full rotate CLW
action 2 4 rotate_clw

# full rotate CLW again
action 2 7 rotate_clw

# in-place rotate CLW
action 2 10 rotate_molecule_clw

# in-place rotate CCLW
action 2 13 rotate_molecule_cclw

# release the pair
action 2 16 release
