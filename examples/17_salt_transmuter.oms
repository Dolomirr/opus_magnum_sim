
# Demonstrates the salt transmuter:
# loose fire atom and loose water atom are each
# carried on transmuter cell, where they turn into salt,
# then delivered to salt exit.

# Fire entrance at (1,3); arm (id 1) rotation 0 has its hand there.
comp 1 3 entrance atom_type=fire   # id 0
comp 2 2 arm                       # id 1

# Water entrance at (6,3); arm (id 3) rotation 0 has its hand there.
comp 6 3 entrance atom_type=water  # id 2
comp 7 2 arm                       # id 3

# Salt exits consume the transformed atoms.
comp 3 1 exit atom_type=salt       # id 4
comp 8 1 exit atom_type=salt       # id 5

# Salt transmuters (single cell; rotation has no effect).
place salt_transmuter 2 3          # id 6
place salt_transmuter 7 3          # id 7

# Arm 1: entrance (1,3) -> transmuter (2,3) -> exit (3,2).
# After the grab the entrance re-spawns spare fire atom that stays fire,
# because it never moves onto the transmuter.
action 1 2 grab
action 1 4 rotate_clw
action 1 6 release
action 1 8 grab
action 1 10 rotate_clw
action 1 12 release

# Arm 2: entrance (6,3) -> transmuter (7,3) -> exit (8,2).
action 3 2 grab
action 3 4 rotate_clw
action 3 6 release
action 3 8 grab
action 3 10 rotate_clw
action 3 12 release
