# Reference: target-threshold delivery.
#
# Same fixed entrypoints and solution as `40_fixed_delivery`,
# but the level requires `target 1`: the run stops as soon as every exit
# cluster has delivered one molecule instead of running to the step limit.
#
# This is level.
# The solution is defined in `examples/44_target_delivery.oms`.

size 6 6
steps 30

# Stop after every exit cluster reaches this delivery count.
target 1

# Entrypoint shapes are defined locally; each cell carries its atom type.
shape entrance_straight_2 entrance cells=(0,0):salt,(-1,1):salt links=0-1
shape exit_straight_2 exit cells=(0,0):salt,(-1,1):salt links=0-1

# Entrance pair spawns a bonded 2-atom molecule on step 0.
entrance entrance_straight_2 2 3 rotation=1

# Exit pair consumes the molecule only if it covers both cells exactly.
exit exit_straight_2 3 2 rotation=2

# Blueprints available to the solution.
allow arm
